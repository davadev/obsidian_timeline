{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tag-check.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:css)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run test:cov)",
      "Bash(npm run build)",
      "Bash(npm run check:dead-code)",
      "Bash(npm run check-release)",
      "Bash(npm run check-release -- --with-build)",
      "Bash(npm run lint:deps)",
      "Bash(npm run lint:cloud-parity)",
      "Bash(npm run typecheck)"
    ]
  }
}
