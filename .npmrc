tag-version-prefix=""
# Do not adopt a dependency version younger than 14 days. Needs npm >= 11.10
# (older npm silently ignores it). Matches the Dependabot cooldown.
min-release-age=14

# Security fixes younger than the age window (SUPPLY-CHAIN 3): fast-xml-parser 5.12.0 fixes alert 14, brace-expansion 1.1.22 /
# 2.1.8 / 5.0.13 fix alerts 5 and 6, is-unsafe is fast-xml-parser's new dependency. Remove these three lines once the versions are
# 14 days old (about 2026-11-24).
min-release-age-exclude[]=fast-xml-parser
min-release-age-exclude[]=is-unsafe
min-release-age-exclude[]=brace-expansion
