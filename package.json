{
  "name": "obsidian-timeline-xml-sync",
  "version": "0.11.0",
  "description": "Two-way sync between Timeline Project XML save files and Obsidian Markdown event notes, with timeline render blocks.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings 0",
    "check-release": "node scripts/check-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "timeline",
    "xml"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.5",
    "yaml": "^2.4.1"
  }
}
